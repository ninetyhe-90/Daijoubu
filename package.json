{
  "name": "daijoubu",
  "version": "1.0.0",
  "type": "module",
  "description": "Daijoubu: an illustrated JLPT vocabulary atlas with Japanese audio, romaji typing and FSRS spaced repetition.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:atlas": "node scripts/check-atlas.mjs",
    "build:atlas": "python3 -B scripts/atlas/build_ja_atlas.py",
    "build:romaji": "python3 -B scripts/atlas/gen_romaji.py",
    "gen:media": "python3 -B scripts/atlas/gen_ja_media.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out ../开源发布/daijoubu",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
